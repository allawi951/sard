{#
| Variable              | Type    | Description                                              |
|-----------------------|---------|----------------------------------------------------------|
| component             | object  | إعدادات التاجر من قسم components في twilight.json        |
| component.background  | ?string | صورة الخلفية                                             |
| component.eyebrow     | ?string | سطر التعريف                                              |
| component.wordmark    | ?string | اسم العلامة (يظهر حرفًا حرفًا) — يعود لاسم المتجر إن فرغ |
| component.subtitle    | ?string |                                                          |
| component.tagline     | ?string |                                                          |
| component.scroll_hint | ?string |                                                          |
| position              | int     | ترتيب العنصر في الصفحة                                   |
#}
{% set wordmark = component.wordmark|default('') ?: store.name %}

<section class="sard-hero" data-testid="store-home-hero" id="sard-hero-{{ position }}">

  {% if component.background %}
    <div class="sard-hero__bg">
      <img src="{{ component.background|cdn(1920) }}" alt="" id="sardHeroImg"
           fetchpriority="high" loading="eager" width="1920" height="1080">
    </div>
  {% endif %}
  <div class="sard-hero__veil"></div>
  <canvas id="sardWater" class="sard-hero__water" aria-hidden="true"></canvas>

  <div class="sard-hero__in">
    {% if component.eyebrow %}
      <p class="sard-eyebrow" id="sardHeroEyebrow">{{ component.eyebrow }}</p>
    {% endif %}

    {#
      مساران متعارضان لا يجتمعان — الشعار **يستبدل** الزخرفة ولا يتراكب معها:

      ١) للمتجر شعار (رفعه التاجر هنا أو شعار المتجر) → يُعرض وحده بكشف متدرّج.
         ملاحظة: سلة تحوّل المرفوع إلى webp ولا تقبل SVG، فالرسم الخطّي على
         شعار التاجر غير ممكن — القناع المتدرّج هو البديل الصحيح.
      ٢) لا شعار → الزخرفة تُرسم خطًّا خطًّا، وتحتها اسم المتجر.
    #}
    {% set hero_logo = component.logo|default('') ?: store.logo %}

    {% if hero_logo %}
      <img class="sard-hero__logo sard-hero__logo--solo" id="sardHeroLogo"
           src="{{ hero_logo|cdn(560) }}"
           alt="{{ store.name }}" width="360" height="150" fetchpriority="high">
    {% else %}
      <div class="sard-hero__mark" id="sardHeroMark">
        {% include 'components.parts.ornament' with { draw: true } only %}
      </div>

      {# نصٌّ واحد لا حروف مفرّقة: تقسيم العربية هنا يكسر وصل الحروف ويعكس ترتيبها.
         التقسيم يتم في sard.js وللنصوص اللاتينية وحدها. #}
      <p class="sard-hero__word" id="sardHeroWord">{{ wordmark }}</p>
    {% endif %}

    {% if component.subtitle %}
      <p class="sard-hero__sub" id="sardHeroSub">{{ component.subtitle }}</p>
    {% endif %}

    {% if component.tagline %}
      <p class="sard-hero__line" id="sardHeroLine">{{ component.tagline }}</p>
    {% endif %}
  </div>

  {% if component.scroll_hint %}
    <div class="sard-hero__cue" id="sardHeroCue">
      <i></i><span>{{ component.scroll_hint }}</span>
    </div>
  {% endif %}
</section>
