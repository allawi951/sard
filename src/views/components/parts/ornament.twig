{#
  زخرفة سرد — عنصر بصري محايد يصلح لأي متجر (لا شعار علامة بعينها).
  شعار المتجر الحقيقي يبقى `store.logo`؛ هذه الزخرفة تؤطّره وتُرسم خطًّا خطًّا.

  المتغيّرات:
    draw    (bool) أضِف صنف sard-draw ليرسم العنصر نفسه بحركة stroke-dashoffset
    compact (bool) نسخة مختصرة للشريط العلوي — بلا المسطرتين والموجة
#}
{% set d = draw|default(false) ? ' sard-draw' : '' %}
<svg class="sard-mark{{ compact|default(false) ? ' sard-mark--compact' : '' }}"
     viewBox="0 0 640 220" aria-hidden="true" focusable="false">

  <g fill="none" stroke="currentColor" stroke-width="3"
     stroke-linecap="round" stroke-linejoin="round">

    {# القوس المزدوج #}
    <g class="sard-arc">
      <path class="{{ d }}" d="M70 140 C 190 62 450 62 570 140"/>
      <path class="{{ d }}" d="M104 148 C 205 84 435 84 536 148"/>
    </g>

    {# المسطرتان الأفقيتان بنهايتين مطرّزتين #}
    <g class="sard-rules">
      <path class="{{ d }}" d="M40 150 H 288"/>
      <path class="{{ d }}" d="M352 150 H 600"/>
      <path class="{{ d }}" d="M40 142 V 158"/>
      <path class="{{ d }}" d="M600 142 V 158"/>
    </g>

    {# المعيّن المركزي #}
    <path class="sard-diamond{{ d }}" d="M320 128 L 344 150 L 320 172 L 296 150 Z"/>

    {# موجة خفيفة تحت المركز #}
    <g class="sard-wave">
      <path class="{{ d }}" d="M196 186 C 236 180 276 192 316 186 C 356 180 396 192 436 186"/>
    </g>
  </g>

  {# العناصر المصمتة: تظهر بالتلاشي بعد اكتمال الرسم #}
  <g class="sard-jewel" fill="currentColor">
    <path d="M320 141 L 329 150 L 320 159 L 311 150 Z"/>
    <circle cx="70" cy="140" r="3.5"/>
    <circle cx="570" cy="140" r="3.5"/>
  </g>
</svg>
