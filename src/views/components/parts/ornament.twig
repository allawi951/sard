{#
  علامة «سرد» — الرمز المعتمد للثيم (الصيغة ٥: الحرف والموجة).
  الحرف يقف على موجة لا على سطر مستقيم: السرد جريان لا سكون.
  الأصول الكاملة (الرمز، الكلمة، القفل، وتصديرات PNG) في `brand/assets`،
  ويولّدها `node brand/build.mjs` من المصدر نفسه فلا تتفرّق النسخ.

  شعار المتجر الحقيقي يبقى `store.logo` ويُرسم **أسفل** هذه العلامة.

  المتغيّرات:
    draw    (bool) أضِف صنف sard-draw ليرسم العنصر نفسه بحركة stroke-dashoffset
    compact (bool) نسخة مختصرة للشريط العلوي — بلا الموجة
#}
{% set d = draw|default(false) ? ' sard-draw' : '' %}
<svg class="sard-mark{{ compact|default(false) ? ' sard-mark--compact' : '' }}"
     viewBox="0 0 100 100" aria-hidden="true" focusable="false">

  <g fill="none" stroke="currentColor" stroke-width="3.4"
     stroke-linecap="round" stroke-linejoin="round">

    {# أسنان الحرف — تتدرّج في الارتفاع فتكسر التناظر #}
    <g class="sard-seen">
      <path class="{{ d }}" d="M34 52 V 40"/>
      <path class="{{ d }}" d="M46 52 V 34"/>
      <path class="{{ d }}" d="M58 52 V 40"/>
      <path class="{{ d }}" d="M28 52 H 64 A 10 10 0 0 1 74 62"/>
    </g>

    {# الموجة التي يقف عليها الحرف #}
    <g class="sard-wave">
      <path class="{{ d }}" d="M14 74 C 30 68 46 80 62 74 C 74 69 82 72 88 76"/>
    </g>
  </g>

  {# نقطة مصمتة تُختم بها الحركة: تظهر بالتلاشي بعد اكتمال الرسم #}
  <g class="sard-jewel" fill="currentColor">
    <circle cx="74" cy="62" r="2.8"/>
  </g>
</svg>
